# Копия в .env: cp .env.example .env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deals_bigdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Дата снимка (as_of). Системная дата запуска НЕ используется нигде.
AS_OF_DATE=2026-10-26
# Окно ETL по loading_date (для backfill меняется здесь или флагами --start/--end)
ETL_START_DATE=2023-01-01
ETL_END_DATE=2027-12-31

RANDOM_SEED=42
MODEL_NAME=catboost_v1
ARTIFACTS_DIR=/app/artifacts
POSTGRES_HOST_PORT=5432   # порт на хосте; если занят локальным Postgres, поставьте 5433
